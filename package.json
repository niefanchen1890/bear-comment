{
  "name": "cusdis",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28",
      "@babel/runtime": "7.28.4",
      "yaml": "1.10.3",
      "minimatch@3": "3.1.4",
      "brace-expansion@1": "1.1.18"
    }
  },
  "scripts": {
    "dev": "DB_TYPE=sqlite pnpm run dev:general",
    "dev:pg": "DB_TYPE=pgsql pnpm run dev:general",
    "dev:mysql": "DB_TYPE=mysql pnpm run dev:general",
    "dev:general": "pnpm run db:deploy && pnpm run db:generate && next dev",
    "build": "DB_TYPE=pgsql pnpm run db:generate && next build && pnpm run build:widget",
    "build:without-migrate": "pnpm run db:generate && next build && pnpm run build:widget",
    "db:deploy": "prisma migrate deploy --schema ./prisma/$DB_TYPE/schema.prisma",
    "db:generate": "prisma generate --schema ./prisma/$DB_TYPE/schema.prisma",
    "db:push": "DB_TYPE=sqlite pnpm run db:push:general",
    "db:push:pg": "DB_TYPE=pgsql pnpm run db:push:general",
    "db:push:mysql": "DB_TYPE=mysql pnpm run db:push:general",
    "db:push:general": "prisma db push --schema ./prisma/$DB_TYPE/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ./prisma/$DB_TYPE/schema.prisma",
    "db:migrateAll": "prisma migrate dev --schema ./prisma/sqlite/schema.prisma && prisma migrate dev --schema ./prisma/pgsql/schema.prisma && prisma migrate dev --schema ./prisma/mysql/schema.prisma",
    "admin": "prisma studio",
    "widget": "vite --config scripts/vite.config.js",
    "start": "next start",
    "start:production": "node scripts/validate-env.mjs && next start",
    "release": "node scripts/validate-env.mjs && pnpm run db:generate && pnpm run db:deploy",
    "cp-widget-lang": "mkdir -p public/js/widget/lang && cp -r widget/lang public/js/widget",
    "build:widget": "pnpm run cp-widget-lang && vite build --config scripts/vite.widget.config.js && pnpm run build:sdk && pnpm run build:iframe && pnpm run build:count",
    "build:sdk": "vite build --config scripts/vite.sdk.config.js",
    "build:iframe": "vite build --config scripts/vite.iframe.config.js",
    "build:count": "vite build --config scripts/vite.count.config.js"
  },
  "prettier": "@egoist/prettier-config",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@hapi/boom": "^9.1.2",
    "@mantine/core": "^6.0.22",
    "@mantine/form": "^6.0.22",
    "@mantine/hooks": "^6.0.22",
    "@mantine/modals": "^6.0.22",
    "@mantine/notifications": "^6.0.22",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^7.120.4",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dayjs": "^1.10.4",
    "fast-xml-parser": "^5.3.1",
    "formidable": "^3.5.4",
    "framer-motion": "^3.2.1",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^15.0.2",
    "milligram": "^1.4.1",
    "nanoid": "^3.3.19",
    "next": "^15.5.26",
    "next-auth": "4.24.15",
    "next-connect": "^0.10.1",
    "nodemailer": "^10.0.10",
    "prisma": "5.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.1.1",
    "react-icons": "^4.3.1",
    "react-query": "3.39.3",
    "redaxios": "^0.4.1",
    "turndown": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-proposal-decorators": "^7.12.12",
    "@egoist/prettier-config": "^0.1.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "babel-plugin-transform-typescript-metadata": "^0.3.1",
    "postcss": "^8.5.28",
    "prettier": "^2.2.1",
    "pretty-quick": "^3.1.0",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "^4.2.20",
    "svelte-preprocess": "^5.1.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.20"
  }
}
