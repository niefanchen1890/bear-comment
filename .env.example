# Copy this file to .env and replace every example value before deployment.
POSTGRES_DB=cusdis
POSTGRES_USER=cusdis
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DB_URL=postgresql://cusdis:replace-with-a-url-safe-database-password@postgres:5432/cusdis

# Public HTTPS address of the Cusdis server. Do not include a trailing slash.
NEXTAUTH_URL=https://comments.example.com
HOST=https://comments.example.com
JWT_SECRET=replace-with-at-least-32-random-characters

# Administrator login. These names avoid the reserved shell USERNAME variable.
CUSDIS_ADMIN_USERNAME=admin
CUSDIS_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Comma-separated origins that may embed the widget.
CORS_ORIGINS=https://www.example.com,https://example.com

# The Compose service binds only to loopback by default for a reverse proxy.
CUSDIS_PORT=3000
TRUST_PROXY=true
COMMENT_RATE_LIMIT_MAX=5
COMMENT_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Optional OAuth. When any provider is enabled, restrict it to explicit emails.
# GITHUB_ID=
# GITHUB_SECRET=
# ALLOWED_AUTH_EMAILS=owner@example.com

# Optional mail notifications. Port 465 normally uses SMTP_SECURE=true;
# port 587 normally uses SMTP_SECURE=false.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SENDER=Cusdis <comments@example.com>

# Optional Telegram notification for every new visitor comment. Configure both
# values together. Keep the bot token secret.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional error reporting.
# SENTRY_DSN=
